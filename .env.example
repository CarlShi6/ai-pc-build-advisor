# Server-only AI provider settings. Do not expose these with a VITE_ prefix.
# AI_PROVIDER switches v3 photo recognition only (openai | mock).
AI_PROVIDER=mock
# ADVISOR_AI_PROVIDER switches the build advisor chat separately (openai | mock; default mock).
ADVISOR_AI_PROVIDER=mock
OPENAI_API_KEY=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4.1-mini
# Photo analysis model (default gpt-5.4; gpt-4.1-mini is about 9x cheaper but misreads more).
IMAGE_AI_MODEL=
# Reasoning effort for gpt-5.x (default low; none was faster but guessed models worse).
IMAGE_AI_REASONING_EFFORT=
# Optional OpenAI-compatible base URL for photo analysis (for example an AI gateway).
IMAGE_AI_BASE_URL=
# Global photo analyses per UTC day (default 100). Counted in the IMAGE_CAP_DB D1 binding on Cloudflare.
IMAGE_ANALYSIS_DAILY_CAP=
# Cloudflare Turnstile on Analyze. The secret is server-only (a Worker secret); the site key is public.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
# Saved builds in the browser (localStorage) instead of the server; always on in production builds.
VITE_BUILD_STORAGE=

# Persistence mode. Use mock for local/demo data or supabase for production persistence.
PERSISTENCE_PROVIDER=mock

# Server-only Stripe Checkout settings for Build Pro. Do not use real keys in commits.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_BUILD_PRO_PRICE_ID=price_your_build_pro_price_id_here
PUBLIC_APP_URL=http://localhost:5173

# Server-side Supabase Auth/Postgres settings for production persistence.
# Keep service role keys server-only and out of VITE_ variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Enables GET /api/smoke/supabase outside development when explicitly set to true.
SUPABASE_SMOKE_TEST_ENABLED=false
