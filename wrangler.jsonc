{
  // Deployment notes: docs/DEPLOY.md ("Cloudflare Workers"). `npm run build` writes
  // .output/server/wrangler.json from this file (nitro sets main and assets itself); deploy
  // from there. Secrets (OPENAI_API_KEY, TURNSTILE_SECRET_KEY) are Worker secrets set with
  // `wrangler secret put`, never vars here and never VITE_*.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-pc-build-advisor",
  "compatibility_date": "2026-06-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_PROVIDER": "openai",
    "IMAGE_ANALYSIS_DAILY_CAP": "30",
    "IMAGE_ANALYSIS_IP_DAILY_CAP": "10",
  },
  // Global daily cap on photo analyses. Create it with `wrangler d1 create aipc-image-cap` and
  // paste the printed database_id here; the table is created on first use.
  "d1_databases": [
    {
      "binding": "IMAGE_CAP_DB",
      "database_name": "aipc-image-cap",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    },
  ],
  // Per-session rate limit on Analyze, shared by every isolate: 3 per 60 s per session key.
  // namespace_id is any positive integer unique within the account.
  "ratelimits": [
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
}
